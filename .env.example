OPENAI_API_KEY=
TAVILY_API_KEY=
# Optional settings (defaults shown)
OPENAI_MODEL=gpt-4.1-mini
MAX_BOOKS=5
MAX_SEARCHES_PER_SESSION=20
MAX_TAVILY_CALLS_PER_MESSAGE=8
MAX_INPUT_CHARS=500
MAX_MESSAGES_PER_SESSION=60
MAX_CONVERSATIONS=200
# LangSmith tracing (optional). Set LANGSMITH_TRACING=true and add your key to turn it on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=book-finder
# Only needed for non-default regions, e.g. https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=
# Google Books (optional). Without a key Google Books is skipped; Open Library is always used.
GOOGLE_BOOKS_API_KEY=
MIN_CATALOG_RATINGS=10
